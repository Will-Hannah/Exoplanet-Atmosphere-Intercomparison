! Namelist file for the tutorial chem_kin: calculating chemical kinetics abundances with a read in PT profile

&UNITS
/

&PARAM 
Debug  = 0
fin = 'tp_tests1_2_6.ncdf'
/

&EOS gamma = 0./

&GRID 
logg   = 3.33
ndepth = 99
mixing = t
kzzcst = 1e9

corr_k = t
/

&CHEMISTRY 
chem  = 'neq' 
fAin = 'tsai2025/chem_tsai2025.ncdf'
!fAin = 'tsai2021_pho2021/chem_tsai2021(+53).ncdf'
fcoeffnine = 'tsai2025/coeff9_NASA_sc.dat'
fAeqout  = 'hd189b_chem_eq_tests1_2_6.ncdf'
fAneqout = 'hd189b_chem_neq_tests_1_2_6.ncdf'
mdh = 0.
init_eq = t
print_chem = t
/

&CHEM_NEQ
dir_neq = 'tsai2025/'
nmol_neq = 91
nfile = 6

tmax = 1e12
rate_limiter = t

photochem= f
/

&RADTRANS 
rstar = 0.805 
rorbit = 0.03142
fred = 1.0
murad = 0.5
/


&OPACITY 
nkap = 0
/

&SOLVER 
solve_hydro  = f
solve_energy = f
/
 
&CONVECTION 
/

